{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"],
  "references": [
    { "path": "../../packages/kernel" },
    { "path": "../../packages/platform" },
    { "path": "../../packages/platform-database" },
    { "path": "../identity" },
    { "path": "../tenant" }
  ]
}
