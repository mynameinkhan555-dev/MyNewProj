{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": ["node"],
    "allowJs": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/platform/client"
    },
    {
      "path": "../../packages/ui"
    }
  ],
  "exclude": ["node_modules"]
}
