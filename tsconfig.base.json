{
  "compilerOptions": {
    "incremental": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": false,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "types": [],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/kernel": ["packages/kernel/src/index.ts"],
      "@workspace/kernel/*": ["packages/kernel/src/*"],
      "@workspace/contracts": ["packages/contracts/src/index.ts"],
      "@workspace/contracts/*": ["packages/contracts/src/*"],
      "@workspace/platform": ["packages/platform/src/index.ts"],
      "@workspace/platform/*": ["packages/platform/src/*"],
      "@workspace/platform-database": ["packages/platform-database/src/index.ts"],
      "@workspace/platform-database/*": ["packages/platform-database/src/*"],
      "@workspace/identity": ["modules/identity/src/index.ts"],
      "@workspace/identity/*": ["modules/identity/src/*"],
      "@workspace/tenant": ["modules/tenant/src/index.ts"],
      "@workspace/tenant/*": ["modules/tenant/src/*"],
      "@workspace/access-control": ["modules/access-control/src/index.ts"],
      "@workspace/access-control/*": ["modules/access-control/src/*"]
    }
  }
}
