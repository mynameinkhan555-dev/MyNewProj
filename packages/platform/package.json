{
  "name": "@workspace/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "import": "./dist/ports/index.js",
      "default": "./src/ports/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./dist/server/index.js",
      "default": "./src/server/index.ts"
    },
    "./presentation": {
      "types": "./src/presentation/index.ts",
      "import": "./dist/presentation/index.js",
      "default": "./src/presentation/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/sdk-trace-node": "^1.29.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@workspace/kernel": "workspace:*",
    "@workspace/platform-database": "workspace:*",
    "@workspace/platform-logger": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.28.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "minio": "^8.0.2",
    "multer": "^2.0.1",
    "pino-http": "^10.5.0",
    "resend": "^4.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3"
  }
}
