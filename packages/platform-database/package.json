{
  "name": "@workspace/platform-database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./drizzle-pg-core": "./src/drizzle-pg-core.ts",
    "./drizzle-client": "./src/drizzle-client.ts",
    "./schema": "./src/schema/index.ts",
    "./unitOfWork": "./src/unitOfWork/index.ts",
    "./unitOfWork/TransactionContext": "./src/unitOfWork/TransactionContext.ts",
    "./persistence": "./src/persistence/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:apply-migrations": "node scripts/apply-migrations.js"
  },
  "dependencies": {
    "@workspace/kernel": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.14.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.14.1",
    "drizzle-kit": "^0.22.8",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
